---
const base = import.meta.env.BASE_URL;
const redirectUrl = `${base}/es/`;
---

<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content={`0;url=${redirectUrl}`}>
  <title>Redirect</title>
</head>
<body>
  <a href={redirectUrl}>Ir a la página</a>
</body>
</html>
