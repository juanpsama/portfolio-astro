---
import { getLang } from '../i18n/utils';
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = getLang(Astro.currentLocale);
const toggleLang = lang === 'es' ? 'en' : 'es';

const currentPath = Astro.url.pathname;
const pathParts = currentPath.replace(base, '').replace(/^\//, '').split('/').filter(Boolean);
pathParts.shift();
const cleanPath = '/' + pathParts.join('/');
const toggleUrl = `${base}/${toggleLang}${cleanPath}`;
---
<div class="inline-flex">

    <a href={toggleUrl} class="inline-flex link-primary">
            <Icon name="language" class="text-4xl" />
            <span class="font-bold font-mono">{lang}</span>
        </a>
        <!-- <ul>
            {Object.entries(languages).map(([lang, label]) => (
            <li>
                <a href={translatePath('/', lang)}>{label}</a>
            </li>
            ))}
        </ul> -->
</div>
