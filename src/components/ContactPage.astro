---
import { Icon } from "astro-icon/components";
import TealBox from "../components/TealBox.astro";
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={t('contact.title')}>
  <TealBox>
    <div class="text-primary">
      <h5 class="flex items-center gap-2 hover:underline decoration-2 text-base sm:text-2xl">
        <Icon name="mdi:alternate-email" />
        <a href="mailto: samajpablo@gmail.com">samajpablo@gmail.com</a>
      </h5>

      <div class="flex sm:flex-row sm:items-center gap-2 mt-2">
        <h5 class="flex items-center gap-2 text-base sm:text-2xl">
          <Icon name="mdi:phone" />
          +52 961 251 9488
        </h5>
        <a
          href="https://wa.me/529612519488"
          target="_blank"
          class="inline-flex items-center gap-1 sm:gap-2 bg-emerald-500 hover:bg-emerald-400 text-white text-sm sm:text-base font-semibold py-1.5 px-3 sm:py-2 sm:px-4 rounded-lg transition-all duration-300 hover:shadow-md w-fit"
        >
          <Icon name="mdi:whatsapp" class="text-2xl" />
          <span class="hidden sm:inline">WhatsApp</span>
        </a>
      </div>
    </div>

    <h2 class="my-5">{t('contact.sendMessage')}</h2>
    <form
      target="_blank"
      action="https://formsubmit.co/samajpablo@gmail.com"
      method="POST"
    >
      <div class="mb-3 columns-1 required">
        <label class="form-label" for="name">
          {t('contact.name')}
        </label>
        <input
          class="rounded-lg block w-full text-black"
          id="name"
          name="name"
          required
          type="text"
          value=""
        />
      </div>

      <div class="mb-3 required">
        <label class="form-label" for="email">
          {t('contact.email')}
        </label>
        <input
          class="rounded-lg block w-full text-black"
          id="email"
          name="email"
          required
          type="email"
          value=""
        />
      </div>

      <div class="mb-3">
        <label class="form-label" for="phone">
          {t('contact.phone')}
        </label>
        <input
          class="rounded-lg block w-full text-black"
          id="phone"
          name="phone"
          type="text"
          value=""
        />
      </div>

      <div class="mb-3 required">
        <label class="form-label" for="message">
          {t('contact.message')}
        </label>
        <textarea
          class="rounded-lg block w-full text-black"
          id="message"
          name="message"
          required
        />
      </div>

      <button
        type="submit"
        class="btn-primary py-2 px-4 rounded-lg"
      >
        {t('contact.send')}
      </button>
    </form>
  </TealBox>
</Layout>